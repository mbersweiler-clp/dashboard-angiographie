                             AND UPPER(vpa.long_description) NOT LIKE 'PIÈCE%MAIN%'

                             THEN 'AIGUILLE'


                         -- ELECTRODES
                         WHEN UPPER(vpa.long_description) LIKE 'ELECTRODE%'
                             OR UPPER(vpa.long_description) LIKE 'EXCEL%DISPOSABLE%'
                             OR UPPER(vpa.long_description) LIKE 'SERFAS%ELECTRODE%'
                             OR UPPER(vpa.long_description) LIKE 'KIT%ELECTRODE%'
                             OR UPPER(vpa.long_description) LIKE 'EIC%5872-01%'
