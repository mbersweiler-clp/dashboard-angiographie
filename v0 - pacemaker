                         -- KIT SERINGUE
                         WHEN UPPER(vpa.long_description) LIKE 'KIT%SERINGUE%' THEN 'SERINGUE'

                         -- KIT PATIENT
                         WHEN UPPER(vpa.long_description) LIKE 'KIT%'
                             AND (
                                  UPPER(vpa.long_description) LIKE '%PATIENT%'
                                  )
                             THEN 'KIT PATIENT'

                         -- KIT ENDOCAVITAIRE
                         WHEN UPPER(vpa.long_description) LIKE 'KIT%'
                             AND (
                                  UPPER(vpa.long_description) LIKE '%ALPINION%'
                                      OR UPPER(vpa.long_description) LIKE '%ENDOCAVITAIRE%'
                                  )
                             THEN 'KIT ENDOCAVITAIRE'

                         -- ECOUVILLON (inclut les kits écouvillons)
                         WHEN
                             UPPER(vpa.long_description) LIKE '%ECOUVILLON%'
                                 OR (
                                 UPPER(vpa.long_description) LIKE 'KIT%'
                                     AND UPPER(vpa.long_description) LIKE '%ECOUVILLON%'
                                 )
                             THEN 'ECOUVILLON'


                         -- KIT INTRODUCTEUR
                         WHEN UPPER(vpa.long_description) LIKE 'KIT%'
                             AND (
                                  UPPER(vpa.long_description) LIKE '%INTRO%'
                                  )
                             THEN 'KIT INTRODUCTEUR'

                         -- KIT ARTHOSCOPIE
                         WHEN UPPER(vpa.long_description) LIKE '%KIT%'
                             AND UPPER(vpa.long_description) LIKE '%FIRSTPASS%'
