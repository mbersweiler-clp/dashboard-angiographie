         FROM ehtrace_CLP.surgery_item si

                  INNER JOIN ehtrace_CLP.versioned_provider_article vpa
                             ON vpa.id = si.versioned_provider_article_id

             -- Dernière version modified surgery patient pour un meme id
                  INNER JOIN (
             SELECT surgery_id, MAX(modified) AS max_modified
             FROM ehtrace_CLP.surgery_patient
             GROUP BY surgery_id
         ) sp_max ON sp_max.surgery_id = si.surgery_id
                  INNER JOIN ehtrace_CLP.surgery_patient sp
                             ON sp.surgery_id = sp_max.surgery_id
                                 AND sp.modified = sp_max.max_modified

             -- Dernière version modified surgery pour un meme id
                  INNER JOIN (
             SELECT id, MAX(modified) AS max_modified
             FROM ehtrace_CLP.surgery
             GROUP BY id
         ) s_max ON s_max.id = si.surgery_id
                  INNER JOIN ehtrace_CLP.surgery s
                             ON s.id = s_max.id
                                 AND s.modified = s_max.max_modified

             -- Dernière version  modified de first_surgery_act pour un meme id
                  INNER JOIN (
             SELECT surgery_id, MAX(modified) AS max_modified
             FROM ehtrace_CLP.first_surgery_act
             GROUP BY surgery_id
         ) fo_max ON fo_max.surgery_id = s.id
                  INNER JOIN ehtrace_CLP.first_surgery_act fo
                             ON fo.surgery_id = fo_max.surgery_id
                                 AND fo.modified = fo_max.max_modified

                  INNER JOIN ehtrace_CLP.surgery_operator so
                             ON so.surgery_id = s.id

                  LEFT JOIN medecin_specialite ms
                            ON ms.med = UPPER(
                                    REPLACE(
                                            REPLACE(
                                                    TRIM(REGEXP_REPLACE(so.full_name, '\\(.*\\)', '')),
                                                    ' ', ''),
                                            '-', '')
                                        )

         WHERE sp.stay_number IS NOT NULL -- code sejour non nul
           AND s.surgery_date >= MAKEDATE(YEAR(CURDATE()), 1) -- a partir de 2026
           AND vpa.long_description IS NOT NULL -- description DM non null
           #    AND vpa.article_type_key <> 'DRUG'
           AND si.status_key ='USED'
           AND fo.surgical_procedure_name IS NOT NULL -- nom de procédure non null
           AND ms.specialite_medecin = 'CARDIO' -- specialité cardio

         GROUP BY sp.stay_number,
                  fo.surgical_procedure_name,
                  so.full_name,
                  ms.specialite_medecin,
                  fo.surgical_specialty_name,
                  s.surgery_date,
                  vpa.article_type_key,
                  categorie_article,
                  vpa.article_type_key

