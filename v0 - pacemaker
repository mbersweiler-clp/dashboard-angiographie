                             OR UPPER(vpa.long_description) LIKE 'CATHETER%')
                             AND UPPER(vpa.long_description) NOT LIKE '%HP9481E%'
                             THEN 'CATHETER'

                         -- TROCARTS
                         WHEN UPPER(vpa.long_description) LIKE 'TROCARD%'
