                             OR UPPER(vpa.long_description) LIKE 'BOOSTING%CATHETER%'
                             OR UPPER(vpa.long_description) LIKE 'CXI%'
                             OR UPPER(vpa.long_description) LIKE 'TELESCOPE%GUIDE%'
                             OR UPPER(vpa.long_description) LIKE 'TOUR%GUIDE%'
                             OR UPPER(vpa.long_description) LIKE 'SUPER%TORQUE%'
                             OR UPPER(vpa.long_description) LIKE 'SUPERTORQUE%'
                             OR UPPER(vpa.long_description) LIKE 'ASC018135%'
                             OR UPPER(vpa.long_description) LIKE '%451401%'
                             OR UPPER(vpa.long_description) LIKE '%451415%'
                             OR UPPER(vpa.long_description) LIKE '%451501%'
                             OR UPPER(vpa.long_description) LIKE '%451504%'
                             OR UPPER(vpa.long_description) LIKE '%451515%'
                             OR UPPER(vpa.long_description) LIKE '%451544%'
