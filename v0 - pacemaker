                             OR UPPER(vpa.long_description) LIKE 'SHOCKWAVE%'
                             OR UPPER(vpa.long_description) LIKE 'CARTHE%'
                             OR UPPER(vpa.long_description) LIKE 'VENFLON%'
                             OR UPPER(vpa.long_description) LIKE 'ATHERECTOMY%'
                             OR UPPER(vpa.long_description) LIKE 'CHIBA% ECHO% AIG%'
                             OR UPPER(vpa.long_description) LIKE 'CHOICE% PT%'
                             OR UPPER(vpa.long_description) LIKE 'IMPULSE%'
                             OR UPPER(vpa.long_description) LIKE 'INSYTE%'
