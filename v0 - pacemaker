                                      OR UPPER(vpa.long_description) LIKE 'SONOLONG%CURL%ECHO%'
                                      OR UPPER(vpa.long_description) LIKE '%NEEDLE%'
                                      OR UPPER(vpa.long_description) LIKE 'MERIT%ADVANCE'
                                      OR UPPER(vpa.long_description) LIKE 'DN0200%AIG%'
                                      OR UPPER(vpa.long_description) LIKE 'ELECTRODE%AIG%'
                                      OR UPPER(vpa.long_description) LIKE 'FLEXOCRIN%AIG%'
                                      OR UPPER(vpa.long_description) LIKE 'PENCAN%'
                                      OR UPPER(vpa.long_description) LIKE 'E14656%AIG%'
                                      OR UPPER(vpa.long_description) LIKE 'TUOHY%SONO%AIG%'
                                      OR UPPER(vpa.long_description) LIKE 'STIMUPLEX%AIGUILLE%'
                                      OR UPPER(vpa.long_description) LIKE 'EPITOME%UTAH%'
