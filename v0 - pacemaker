                         -- AGRAFEUSE
                         WHEN UPPER(vpa.long_description) LIKE 'AGRAFEU%'
                             OR UPPER(vpa.long_description) LIKE 'PROTACK%MM%'
                             OR UPPER(vpa.long_description) LIKE 'PINCE%GCS40G%'
                             OR UPPER(vpa.long_description) LIKE 'VISISTAT%AGRAFEUSE%'
                             OR (UPPER(vpa.long_description) LIKE '%STAPLE%' AND UPPER(vpa.long_description) NOT LIKE 'CHARGEUR%')
                             OR (UPPER(vpa.long_description) LIKE '%STAPPLE%' AND UPPER(vpa.long_description) NOT LIKE 'CHARGEUR%')
                             OR (UPPER(vpa.long_description) LIKE 'AGRAF%COUPANTE%COURBE%')
                             THEN 'AGRAFEUSE'

                         -- AGRAFE
                         WHEN UPPER(vpa.long_description) LIKE 'AGRAFE%' THEN 'AGRAFE'

                         -- PROTECTION SONDE
                         WHEN (
                             (UPPER(vpa.long_description) LIKE 'PROTECTION% SONDE%'
                                 OR UPPER(vpa.long_description) LIKE 'COUVRE%SDE%'
                                 OR UPPER(vpa.long_description) LIKE 'PROTECTION%PC1290%'
                                 OR UPPER(vpa.long_description) LIKE 'COUVRE%SONDE%'
                                 OR UPPER(vpa.long_description) LIKE 'KIT%COUVRE%SONDE%')
