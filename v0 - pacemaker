                         -- KIT
                         WHEN UPPER(vpa.long_description) LIKE 'KIT%' THEN 'KIT'

                         -- PLATEFORME
                         WHEN UPPER(vpa.long_description) LIKE 'PLATEFORME%GELPOINT%' THEN 'PLATEFORME GYNECO'

                         -- VIS
