                )
                THEN 'CHIR MAIN'
            ELSE referring_doctor_specialty
            END AS specialite_medecin
    FROM apigem_clp.clinical_patient_stay
),
     articles_par_sejour AS(
         SELECT
             sp.stay_number AS code_sejour,
             fo.surgical_procedure_name AS Intervention,
             DATE_FORMAT(DATE(s.surgery_date), '%Y-%m-%d') AS DOP,

             #    s.identifier AS Identifier,
