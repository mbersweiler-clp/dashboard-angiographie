                             AND (
                                  UPPER(vpa.long_description) LIKE '%KIT%'
                                  )
                             THEN 'KIT POUDRAGE'

                         -- KIT ORTHOPEDIE
                         WHEN
                             (
                                 UPPER(vpa.long_description) LIKE 'KIT%'
                                     OR UPPER(vpa.long_description) LIKE 'ACP%KIT%'
                                 )
                                 AND (
                                 UPPER(vpa.long_description) LIKE '%BROCHE%'
                                     OR UPPER(vpa.long_description) LIKE '%VISEE%CHONDRAL%'
                                     OR UPPER(vpa.long_description) LIKE '%ANCRE%'
                                     OR UPPER(vpa.long_description) LIKE '%ARTHREX%'
                                     OR UPPER(vpa.long_description) LIKE '%FEMORAL%'
                                 )
                             THEN 'KIT ORTHOPEDIE'


                         -- KIT ENDOSCOPIE
                         WHEN
                             (
                                 UPPER(vpa.long_description) LIKE 'KIT%'
                                     AND (
                                     UPPER(vpa.long_description) LIKE '%ENDO%'
                                         OR UPPER(vpa.long_description) LIKE '%OESOPHAGIENNES%'
                                         OR UPPER(vpa.long_description) LIKE '%GPE%'
                                         OR UPPER (vpa.long_description) LIKE '%ALPINION%'
