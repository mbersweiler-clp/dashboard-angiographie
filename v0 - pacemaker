                             AND (
                                  UPPER(vpa.long_description) LIKE '%MICROPONCTION%'
                                      OR UPPER(vpa.long_description) LIKE '%MICROPUNCTURE%'
                                      OR UPPER(vpa.long_description) LIKE '%SONOSITE%'
