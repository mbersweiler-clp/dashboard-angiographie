                             OR UPPER(vpa.long_description) LIKE '%PLATINE LATERALISEE%'
                             THEN 'PLATINE GLENOIDE'

                         -- FILS / TROCARES
                         WHEN UPPER(vpa.long_description) LIKE '%KIRSCHNER%'
                             THEN 'FILS / TROCARES ORTHOPEDIE'

                         -- CONE TIBIAL
                         WHEN UPPER(vpa.long_description) LIKE '%CONE%'
                             AND UPPER(vpa.long_description) LIKE '%TIB%'
                             THEN 'CONE TIBIAL'

                         -- QUILLE
                         WHEN UPPER(vpa.long_description) LIKE 'QUILLE%'
                             OR UPPER(vpa.long_description) LIKE '%QUILLE TIBIAL%'
                             THEN 'QUILLE'

                         -- MAILLE HERNIAIRE
                         WHEN (UPPER(vpa.long_description) LIKE '%PROLENE%'
                             AND UPPER(vpa.long_description) LIKE '%HERNIE%')
                             OR (UPPER(vpa.long_description) LIKE '%COMPOSITE%'
                                 AND UPPER(vpa.long_description) LIKE '%VENTRAL%')
                             OR UPPER(vpa.long_description) LIKE '%PROMESH%'
