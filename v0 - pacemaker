SELECT
    t.cout_non_refacturable AS `Coût total non refacturables TTC`,
    t.cout_refacturable AS `Coût total refacturables TTC`,
    t.cout_total AS `Coût global TTC`,
    t.categorie_article AS `Catégorie`,
    a.`type_article` AS Nature,
#    ROUND(COUNT(DISTINCT a.code_sejour) * 100 / st.total_sejours, 1) AS `Pourcentage utilisation (%)`,
    ROUND(SUM(a.nb_article) / st.total_sejours,1)  AS `Nombre moyen / séjour`,
    ROUND(t.cout_total / st.total_sejours,1)  AS `Coût moyen / séjour`,
    t.Intervention AS `Motif intervention`,
    t.operateur AS `Opérateurs`,
    t.specialite_medecin AS `Spécialité médecin`,
    t.specialite_acte AS `Spécialité acte ethrace`,
    COUNT(DISTINCT a.code_sejour) AS `Séjours concernés par articles`,
    st.total_sejours AS `Nombre total de séjours`,
    SUM(a.nb_article) AS `Nombre total articles utilisés`
FROM articles_par_sejour a
         INNER JOIN total_par_groupe t
                    ON t.Intervention = a.Intervention
                        AND t.operateur = a.operateur
                        AND t.specialite_medecin = a.specialite_medecin
                        AND t.specialite_acte = a.specialite_acte
                        AND t.categorie_article = a.categorie_article
         INNER JOIN sejours_totaux st
                    ON st.Intervention = a.Intervention
                        AND st.operateur = a.operateur
                        AND st.specialite_medecin = a.specialite_medecin
                        AND st.specialite_acte = a.specialite_acte
GROUP BY
    t.Intervention,
    t.operateur,
    t.specialite_medecin,
    t.specialite_acte,
    t.categorie_article,
    st.total_sejours,
    a.type_article,
    t.cout_total,
    t.cout_non_refacturable,
    t.cout_refacturable
HAVING st.total_sejours >= 1
   AND t.cout_total / st.total_sejours >= 20
   AND t.Intervention = 'Changement boitier de pace maker'
ORDER BY t.Intervention;
