                                 OR UPPER(vpa.long_description) LIKE 'ANGIOJET%'
                                 OR UPPER(vpa.long_description) LIKE 'COLONIC%FTRD%'
                                 OR UPPER(vpa.long_description) LIKE '%MAP352%'
                             THEN 'KIT ANGIO'


                         -- KIT UROLOGIE
