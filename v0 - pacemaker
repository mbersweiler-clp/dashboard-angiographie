                         -- ECARTEUR
                         WHEN UPPER(vpa.long_description) LIKE 'ECART%' THEN 'ECARTEUR'

                         -- PROTECTEUR
                         WHEN UPPER(vpa.long_description) LIKE 'PROTECTEUR%' THEN 'PROTECTEUR'

                         -- RETRACTEUR
                         WHEN UPPER(vpa.long_description) LIKE 'RETRACTEUR%'
                             OR UPPER(vpa.long_description) LIKE '%RETRACT%'THEN 'RETRACTEUR'

                         -- ANNEAU
                         WHEN UPPER(vpa.long_description) LIKE 'ANNEAU%' THEN 'ANNEAU'

                         -- DISPOSITIF SUPRAGLOTTIQUE
                         WHEN UPPER(vpa.long_description) LIKE '%DISPOSITIF%SUPRAGLOTTIQUE%'
