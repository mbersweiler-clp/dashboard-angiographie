                             OR UPPER(vpa.long_description) LIKE 'ELECTRODES%' THEN 'ELECTRODES'

                         -- PANSEMENT
                         WHEN UPPER(vpa.long_description) LIKE 'PANS%'
                             OR UPPER(vpa.long_description) LIKE 'URGOTUL%'
                             OR UPPER(vpa.long_description) LIKE 'TELACOMP%'
                             OR UPPER(vpa.long_description) LIKE 'TELASORB%'
                             OR UPPER(vpa.long_description) LIKE '%PANSEMENT%'
                             OR UPPER(vpa.long_description) LIKE 'COMFEEL%TRANSP%'
                             OR UPPER(vpa.long_description) LIKE 'MELGISORB%BOITE%'
                             OR UPPER(vpa.long_description) LIKE 'MELGISORB%BTE%'
                             OR UPPER(vpa.long_description) LIKE 'MEPILEX%BORDER%'
                             OR UPPER(vpa.long_description) LIKE 'COSMOPOR%BTE%'
                             OR UPPER(vpa.long_description) LIKE 'ALGOSTERIL%'
                             OR UPPER(vpa.long_description) LIKE 'CICAPLAIE%'
                             OR UPPER(vpa.long_description) LIKE 'COMFEEL%'
                             OR UPPER(vpa.long_description) LIKE 'OPSITE%'
                             OR UPPER(vpa.long_description) LIKE 'MEPILEX%'
                             OR UPPER(vpa.long_description) LIKE 'MEPITEL%'
                             OR UPPER(vpa.long_description) LIKE 'MEPITEL%'
                             OR UPPER(vpa.long_description) LIKE 'KIT%VIVANOMED%'
                             OR UPPER(vpa.long_description) LIKE 'LEUKOMED%CONTROL%'
                             OR UPPER(vpa.long_description) LIKE 'TEGADERM%'
                             OR UPPER(vpa.long_description) LIKE '%PSMT%'
                             OR UPPER(vpa.long_description) LIKE '%ALLEVYN%GENTLE%BORDER%'
                             OR UPPER(vpa.long_description) LIKE '%AQUACEL%'
                             OR UPPER(vpa.long_description) LIKE 'FILM%ADH%TEGADERM%'
