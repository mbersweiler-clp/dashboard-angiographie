                                             WHEN UPPER(vpa.long_description) LIKE '%INSERT%INVERSEE%GLENOSPHE%' THEN 'SPHERE/PLATINE GLENOIDIENNE'

                                             -- EMBASE GLENOIDE
                                             WHEN UPPER(vpa.long_description) LIKE '%EMBASE GLENOIDIENNE%'
                                                 AND UPPER(vpa.long_description) LIKE '%SANS CIMENT%'
                                                 THEN 'EMBASE GLENOIDE SANS CIMENT'

                                             WHEN  UPPER(vpa.manufacturer_article_reference) = '0010I8002'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '00017I1612'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '0010I8003'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '0016I2612'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '0010I8001'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '0017I0812'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '022I2615'
                                                 OR UPPER(vpa.manufacturer_article_reference) = '0017I0512'
                                                 THEN 'EMBASE GLENOIDE SANS CIMENT'

                                             -- ATHÉRECTOMIE CORONAIRE / ROTABLATOR
                                             WHEN UPPER(vpa.long_description) LIKE '%ROTA PRO%'
                                                 OR UPPER(vpa.long_description) LIKE '%ROTABLATOR PRO%'
                                                 THEN 'ROTABLATOR CORONAIRE'

                                             -- ESPACEUR HUMERAL
                                             WHEN UPPER(vpa.long_description) LIKE '%ESPACEUR%'
                                                 AND UPPER(vpa.long_description) LIKE '%HUMERAL%'
                                                 THEN 'ESPACEUR HUMERAL'

                                             -- RECHARGES INSTRUMENT CHIRURGICAL
                                             WHEN UPPER(vpa.long_description) LIKE '%RECHARGE SUREFORM%'
                                                 OR UPPER(vpa.long_description) LIKE '%LAME DE SCIE%'
                                                 OR UPPER(vpa.long_description) LIKE '%LAME%STRYKER%'
                                                 OR UPPER(vpa.long_description) LIKE '%LAME%SCIE%'
                                                 OR UPPER(vpa.long_description) LIKE 'CHARGEUR%PR%INST%'
                                                 OR UPPER(vpa.long_description) LIKE 'CHARGEUR%CLIP%POUR%'
                                                 THEN 'RECHARGE INSTRUMENT CHIRURGICAL'

                                             -- CUPULE
                                             WHEN (UPPER(vpa.long_description) LIKE '%CUPULE%'
                                                 OR UPPER(vpa.long_description) LIKE '%VERSAFIT%CUP%'
                                                 OR UPPER(vpa.long_description) LIKE 'APRICOT%CUP%'
                                                 OR UPPER(vpa.long_description) LIKE 'METAL%BACK%'
                                                 OR UPPER(vpa.long_description) LIKE 'CUP%TRAPEZ%'
                                                 OR UPPER(vpa.long_description) LIKE 'COTYLE%AVANTAGE%'
                                                 OR UPPER(vpa.long_description) LIKE '%SYMBOL%CUP%')
                                                 AND UPPER(vpa.long_description) NOT LIKE '%IMPLT%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%STELLAR%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%PION%'
                                                 THEN 'CUPULE'

                                             -- PRESS FIT POST
                                             WHEN UPPER(vpa.long_description) LIKE '%PRESS FIT%'
                                                 OR UPPER(vpa.long_description) LIKE '%PRESS-FIT%'
                                                 THEN 'COMPOSANT PRESS FIT'

                                             -- BASE D'ANCRAGE ORTHOPÉDIQUE
                                             WHEN UPPER(vpa.long_description) LIKE '%BASE ANCRAGE%'
                                                 OR UPPER(vpa.long_description) LIKE '%EASYTECH%'
                                                 THEN 'BASE ANCRAGE ORTHOPÉDIQUE'

                                             -- BANDELETTE ORTHOPEDIQUE
                                             WHEN UPPER(vpa.long_description) LIKE '%BANDELETTE%'
                                                 AND (UPPER(vpa.long_description) LIKE '%ORTHO%'
                                                     OR UPPER(vpa.long_description) LIKE '%LIGAMENT%'
                                                      )
                                                 THEN 'BANDELETTE ORTHOPEDIQUE'

                                             -- PROTHESE DISCALE (rachis lombaire / cervical)
                                             WHEN UPPER(vpa.long_description) LIKE '%PRODISC%'
                                                 OR UPPER(vpa.long_description) LIKE '%DISC%'
                                                 OR UPPER(vpa.long_description) LIKE '%ENDPLATE%'
                                                 OR UPPER(vpa.long_description) LIKE '%INLAY%'
                                                 THEN 'PROTHESE DISCALE'
  
                                             -- CANULE
                                             WHEN UPPER(vpa.long_description) LIKE '%CANULE%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%AUTOFIX%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%FAST FIX%'
                                                 THEN 'CANULE'

                                             -- ANNEAU DE SOUTIEN (ORTHOPEDIQUE HANCHE)
                                             WHEN (UPPER(vpa.long_description) LIKE '%ANNEAU DE SOUTIEN%'
                                                 AND UPPER(vpa.long_description) LIKE '%HANCHE%')
                                                 OR UPPER(vpa.long_description) LIKE 'ANNEAU%SOUT.%'
                                                 OR UPPER(vpa.long_description) LIKE 'ANNEAU%SOUTIEN%'
                                                 THEN 'ANNEAU DE SOUTIEN'

                                             -- ANNEAU DE TENSION CAPSULAIRE
                                             WHEN UPPER(vpa.long_description) LIKE '%TENSION CAPSULAIRE%'
                                                 OR UPPER(vpa.long_description) LIKE '%CAPSULAIRE%'
                                                 THEN 'ANNEAU DE TENSION CAPSULAIRE'

                                             -- MANCHETTE URINAIRE
                                             WHEN UPPER(vpa.long_description) LIKE '%MANCHETTE%'
                                                 AND (UPPER(vpa.long_description) LIKE '%URINAIRE%'
                                                     OR UPPER(vpa.long_description) LIKE '%OCCLUSIVE%'
                                                      )
                                                 THEN 'MANCHETTE URINIAIRE'

                                             -- POMPE URINAIRE IMPLANTABLE
                                             WHEN UPPER(vpa.long_description) LIKE '%POMPE DE CONTROLE%'
                                                 THEN 'POMPE URINAIRE'

                                             -- BALLON PRESSION UROLOGIE
                                             WHEN (UPPER(vpa.long_description) LIKE '%BALLON%'
                                                 AND UPPER(vpa.long_description) LIKE '%AMS800%')
                                                 OR UPPER(vpa.long_description) LIKE 'BALLON 800%'
                                                 THEN 'BALLON DE PRESSION UROLOGIE'

                                             ELSE SUBSTRING_INDEX(vpa.long_description, ' ', 1) END
                                     ELSE SUBSTRING_INDEX(vpa.long_description, ' ', 1)
                                     END AS group_name

                          FROM ehtrace_CLP.surgery_item si
                                   JOIN ehtrace_CLP.versioned_provider_article vpa
                                        ON vpa.id = si.versioned_provider_article_id
     )


