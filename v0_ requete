         INNER JOIN ehtrace_CLP.surgery_patient sp
                    ON sp.surgery_id = s.id
         INNER JOIN (
    SELECT surgery_id, MAX(modified) AS max_modified
    FROM ehtrace_CLP.surgery_patient
    GROUP BY surgery_id
) sp_max ON sp.surgery_id = sp_max.surgery_id
    AND sp.modified = sp_max.max_modified

-- Filtre versioning FIRST_SURGERY_ACT
         INNER JOIN ehtrace_CLP.first_surgery_act fo
                    ON fo.surgery_id = s.id
         INNER JOIN (
    SELECT surgery_id, MAX(modified) AS max_modified
    FROM ehtrace_CLP.first_surgery_act
    GROUP BY surgery_id
) fo_max ON fo.surgery_id = fo_max.surgery_id
    AND fo.modified = fo_max.max_modified

         JOIN ehtrace_CLP.surgery_operator so
              ON so.surgery_id = s.id

         LEFT JOIN medecin_specialite ms
                   ON ms.med = UPPER(
                           REPLACE(
                                   REPLACE(
                                           TRIM(REGEXP_REPLACE(so.full_name, '\\(.*\\)', '')),
                                           ' ', ''
                                   ),
                                   '-', ''
                           )
                               )

         LEFT JOIN ehtrace_CLP.surgery_item si
                   ON si.surgery_id = s.id
                       AND si.status_key = 'USED'

         LEFT JOIN ehtrace_CLP.versioned_provider_article vpa
                   ON vpa.id = si.versioned_provider_article_id
                       AND vpa.long_description IS NOT NULL

WHERE s.provider_id = '0d6266ce-90bc-4724-b10e-5577b29fa1a1' -- clinique CLP
  AND s.surgery_date >= MAKEDATE(YEAR(CURDATE()), 1) -- année en cours
  AND sp.stay_number IS NOT NULL -- code séjour non null 
  AND fo.surgical_procedure_name IS NOT NULL -- nom procédure non null 
  AND ms.specialite_medecin = 'CARDIO' -- spécialité cardiologie

GROUP BY
    s.id,
    sp.stay_number,
    fo.surgical_procedure_name,
    so.full_name,
    DATE_FORMAT(s.surgery_date, '%Y-%m-%d'),
    ms.specialite_medecin,
    fo.surgical_specialty_name

ORDER BY 
    DATE_FORMAT(s.surgery_date, '%Y-%m-%d') DESC;


```
