                                                         OR UPPER(vpa.long_description) LIKE '%SANS-CIMENT%'
                                                         OR UPPER(vpa.long_description) LIKE '%CONTINUUM%'
                                                         OR UPPER(vpa.long_description) LIKE '%CERAFIT%'
                                                         OR UPPER(vpa.long_description) LIKE '%AVANTAGE%'
                                                         OR UPPER(vpa.long_description) LIKE '%FREELINER%'
                                                         OR UPPER(vpa.long_description) LIKE '%TRIDENT%'
                                                         OR UPPER(vpa.long_description) LIKE '%SANS CIMENT%'
                                                         OR UPPER(vpa.long_description) LIKE '%NON%CIM%'
                                                         OR UPPER(vpa.long_description) LIKE '%STELLAR%SS%CIM%'
                                                     )
                                                     AND UPPER(vpa.long_description) NOT LIKE '%VERSAFIT%'
                                                     AND UPPER(vpa.long_description) NOT LIKE '%AVANTAGE%'

                                                 )
                                                 THEN 'COTYLE'

                                             WHEN UPPER(vpa.long_description) LIKE 'CONTINIUUM%SHELL%'
                                                 OR UPPER(vpa.long_description) LIKE 'CONTINUUM%SHELL%'
                                                 OR UPPER(vpa.long_description) LIKE 'IMPLT%MOB%SANS%CI%'
                                                 OR UPPER(vpa.long_description) LIKE 'STELLAR%CUPULE%AMPLITUDE%'
                                                 THEN 'COTYLE'

                                             -- COTYLE CIMENTE
                                             WHEN (UPPER(vpa.long_description) LIKE '%COTYLE%'
                                                 AND (UPPER(vpa.long_description) LIKE '%CIMENTE%'
                                                     OR UPPER(vpa.long_description) LIKE '%A CIMENTE%'
                                                     OR UPPER(vpa.long_description) LIKE '%POLYETHY%HC%'
                                                     OR UPPER(vpa.long_description) LIKE '%DEDIENNE%CEM%'))
                                                 AND UPPER(vpa.long_description) NOT LIKE '%VERSAFIT%'
                                                 THEN 'COTYLE'

                                             -- PARTICULES / MICROSPHERES POUR EMBOLISATION
                                             WHEN UPPER(vpa.long_description) LIKE '%HYDROPEARL%'
                                                 OR UPPER(vpa.long_description) LIKE '%MICROSPHERE%'
                                                 OR UPPER(vpa.long_description) LIKE '%EMBOLISATION%'
                                                 OR UPPER(vpa.long_description) LIKE '%PARTICULE%'
                                                 THEN 'MICROSPHERE'

                                             -- COTYLE SPECIFIQUE / CERAMIQUE / METAL HYPE
                                             WHEN UPPER(vpa.long_description) LIKE '%COTYLE%'
                                                 AND (UPPER(vpa.long_description) LIKE '%CERAMIC%'
                                                     OR UPPER(vpa.long_description) LIKE '%CERAMIQUE%'
                                                     OR UPPER(vpa.long_description) LIKE '%EXCUSIF%'
                                                     OR UPPER(vpa.long_description) LIKE '%METAL%')
                                                 THEN 'COTYLE SPECIFIQUE'

                                             -- CHAMBRE VEINEUSE
                                             WHEN UPPER(vpa.long_description) LIKE 'CELSITE%'
                                                 OR UPPER(vpa.long_description) LIKE 'CHAMBRE%CELSITE%'
                                                 OR UPPER(vpa.long_description) LIKE 'KIT%CHAMBRE%'
                                                 OR UPPER(vpa.long_description) LIKE 'CHAMBRE%IMPLANTABLE%'
                                                 THEN 'CHAMBRE VEINEUSE'

                                             -- BROCHES
                                             WHEN UPPER(vpa.long_description) LIKE '%BROCHE%'
                                                 OR UPPER(vpa.long_description) LIKE '%K-WIRE%'
                                                 OR UPPER(vpa.long_description) LIKE 'PIN%REVERSE%'
                                                 OR UPPER(vpa.long_description) LIKE '%KIRSCHNER%'
                                                 THEN 'BROCHE'


                                             -- STENT BILIAIRE / DIGESTIF
                                             WHEN UPPER(vpa.long_description) LIKE '%WALLFLEX%'
                                                 AND (UPPER(vpa.long_description) LIKE '%BILIARY%' OR UPPER(vpa.long_description) LIKE '%COLONIC%')
                                                 THEN 'STENT BILIAIRE'

                                             -- SOLUTION VISCOELASTIQUE
                                             WHEN UPPER(vpa.long_description) LIKE '%DUOVISC%'
                                                 THEN 'SOLUTION VISCOELASTIQUE'

                                             -- SOLUTION HEMOSTATIQUE
                                             WHEN UPPER(vpa.long_description) LIKE 'SOLUTION%HEMOSTATIQUE%'
                                                 THEN 'SOLUTION HEMOSTATIQUE'

                                             -- FONDS DE COTYLE
                                             WHEN UPPER(vpa.long_description) LIKE 'FOND DE COTYLE%'
                                                 OR UPPER(vpa.long_description) LIKE 'PTH%REPRISE%CAGE%COTYLE%'
                                                 OR UPPER(vpa.long_description) LIKE '%COTYLE%KERBOULL%'
                                                 THEN 'FOND DE COTYLE'

                                             -- CROIX KERBOULL
                                             WHEN UPPER(vpa.long_description) LIKE 'CROIX%KERBOULL%'
                                                 OR UPPER(vpa.long_description) LIKE 'SERF%CROIX%KERBOULL%'
                                                 THEN 'CROIX DE KERBOULL'

                                             -- ALESOIR
                                             WHEN UPPER(vpa.long_description) LIKE '%ALESOIR%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%GUIDE%'
                                                 THEN 'ALESOIR'

                                             -- IMPLANT COIN/CALE/DEMI CALE
                                             WHEN UPPER(vpa.long_description) LIKE '%COIN SPONGIEUX%'
                                                 OR UPPER(vpa.long_description) LIKE '%COIN ARRONDI%'
                                                 OR UPPER(vpa.long_description) LIKE 'COIN%TIBIAL%'
                                                 OR UPPER(vpa.long_description) LIKE 'DEMI CALE%'
                                                 OR (UPPER(vpa.long_description) LIKE 'TRIATHLON%'
                                                     AND UPPER(vpa.long_description) LIKE '%CALE%'
                                                     AND UPPER(vpa.long_description) LIKE '%DEMI%')
                                                 OR UPPER(vpa.long_description) LIKE 'CALE%'
                                                 OR UPPER(vpa.long_description) LIKE 'ATTUNE CALE%'
                                                 OR UPPER(vpa.long_description) LIKE 'BLOC%TIBIAL%'
                                                 OR (UPPER(vpa.long_description) LIKE 'NEXGEN%'
                                                     AND UPPER(vpa.long_description) LIKE '%CALE%')
                                                 THEN 'IMPLANT COIN/CALE'

                                             -- SURFACE ARTICULAIRE
                                             WHEN UPPER(vpa.long_description) LIKE 'SURFACE%'
                                                      AND UPPER(vpa.long_description) LIKE '%ARTICULAIRE%'
                                                 OR (UPPER(vpa.long_description) LIKE 'NEXGEN%'
                                                     AND UPPER(vpa.long_description) LIKE '%ARTICULAIRE%')
                                                 OR (UPPER(vpa.long_description) LIKE 'PERSONA%'
                                                     AND UPPER(vpa.long_description) LIKE '%SURF%')
                                                 OR (UPPER(vpa.long_description) LIKE 'PSN%'
                                                     AND UPPER(vpa.long_description) LIKE '%SURF%')
                                                 THEN 'SURFACE ARTICULAIRE'

                                             -- ENDOBUTTON
                                             WHEN UPPER(vpa.long_description) LIKE '%ENDOBUTTON%'
                                                 OR UPPER(vpa.long_description) LIKE 'SURBOUTON%'
                                                 OR UPPER(vpa.long_description) LIKE 'BOUTON DOGBONE%'
                                                 OR UPPER(vpa.long_description) LIKE 'KNITBUTTON%'
                                                 OR UPPER(vpa.long_description) LIKE 'SMS%BOUTON%'
                                                 THEN 'BOUTON FIXATION LIGAMENTAIRE'

                                             -- CLIPS
                                             WHEN (
                                                 (UPPER(vpa.long_description) LIKE '%ENDO%'
                                                     AND UPPER(vpa.long_description) LIKE '%CLIP%')
                                                     OR UPPER(vpa.long_description) LIKE 'CLIP%'
                                                     OR UPPER(vpa.long_description) LIKE 'POSE-CLIPS%'
                                                     OR UPPER(vpa.long_description) LIKE '%LIGACLIP%'
                                                     OR UPPER(vpa.long_description) LIKE 'APPLICATEUR%CLIP%'
                                                     OR UPPER(vpa.long_description) LIKE 'MULTI-APPLICATEUR%CLIP%'
                                                     OR UPPER(vpa.long_description) LIKE 'HEM-O-LOK%'
                                                     OR UPPER(vpa.long_description) LIKE 'SURGICLIP%'
                                                 )
                                                 THEN 'SYSTEME CLIP LIGATURE'

                                             -- COMPOSANT FEMORAL
                                             WHEN (
                                                 (
                                                     UPPER(vpa.long_description) LIKE '%COMPOSANT%'
                                                         AND UPPER(vpa.long_description) LIKE '%FEMORAL%'
                                                         AND UPPER(vpa.long_description) LIKE '%CIMENTE%'
                                                     )
                                                     OR UPPER(vpa.long_description) LIKE '%FEMUR%UNITED%PS-U2%'
                                                     OR UPPER(vpa.long_description) LIKE 'ANATOMIC%FEMUR%'
                                                     OR UPPER(vpa.long_description) LIKE 'CONDYLE%FEMURAL%ANATOMIC%PS%'

                                                     OR (
                                                     UPPER(vpa.long_description) LIKE '%COMPOSANT%'
                                                         AND UPPER(vpa.long_description) LIKE '%FEMORAL%'
                                                     )

                                                     OR (
                                                     UPPER(vpa.long_description) LIKE '%FEMUR%'
                                                         AND UPPER(vpa.long_description) LIKE '%ESSAI%'
                                                     )

                                                     OR (
                                                     UPPER(vpa.long_description) LIKE 'MRH%'
                                                         AND UPPER(vpa.long_description) LIKE '%FEMORO/TIBIAL%'
                                                     )
                                                     OR (
                                                     UPPER(vpa.long_description) LIKE 'MRH%'
                                                         AND UPPER(vpa.long_description) LIKE '%CHARNIERE%'
                                                     )

                                                     OR (
                                                     UPPER(vpa.long_description) LIKE 'FEMUR%'
                                                         AND UPPER(vpa.long_description) LIKE '%EVOLUTION CS%'
                                                     )

                                                     OR (
                                                     (UPPER(vpa.long_description) LIKE '%FEMUR%'
                                                         OR UPPER(vpa.long_description) LIKE '%FÉMORAL%')
                                                         AND UPPER(vpa.long_description) NOT LIKE '%BOUCHON%'
                                                         AND UPPER(vpa.manufacturer_name) NOT LIKE '%BIOBANK%'
                                                     )
                                                 )
                                                 THEN 'COMPOSANT FEMORAL'

                                             -- COMPOSANTS  CUBITAL
                                             WHEN UPPER(vpa.long_description) LIKE '%COMPOSANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%CUBITAL%'
                                                 THEN 'COMPOSANT CUBITAL'

                                             -- COMPOSANTS  HUMERAL
                                             WHEN (UPPER(vpa.long_description) LIKE '%COMPOSANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%HUMERAL%')
                                                 OR UPPER(vpa.long_description) LIKE 'METAPHYSE%HUMERALE%'
                                                 OR UPPER(vpa.long_description) LIKE '%PLATEFORME REVERSED%'
                                                 OR UPPER(vpa.long_description) LIKE 'ASCEND%PLATEFORME%'
                                                 OR UPPER(vpa.long_description) LIKE 'IMPLT%PTE%REHAUSSEUR%'
                                                 THEN 'COMPOSANT HUMERAL'

                                             -- COMPOSANTS  TIBIALE
                                             WHEN (UPPER(vpa.long_description) LIKE '%COMPOSANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%TIBIAL%')
                                                 OR (UPPER(vpa.long_description) LIKE '%PLATEAU%'
                                                     AND UPPER(vpa.long_description) LIKE '%TIBIAL%')
                                                 OR (UPPER(vpa.long_description) LIKE 'ENTRETOISE%'
                                                     AND UPPER(vpa.long_description) LIKE '%TIBIALE%')
                                                 OR (UPPER(vpa.long_description) LIKE 'ENTRETOISE%'
                                                     AND UPPER(vpa.long_description) LIKE '%EVOLUTION%')
                                                 OR UPPER(vpa.long_description) LIKE 'COMPOSANT%JOURNEY%'
                                                 OR UPPER(vpa.long_description) LIKE 'ATTUNE%TIB%SLV%'
                                                 OR UPPER(vpa.long_description) LIKE 'ATTUNE%REV%TIB%BASE%'
                                                 OR UPPER(vpa.long_description) LIKE 'OXFORD%TIBIA%'
                                                 OR UPPER(vpa.long_description) LIKE 'TIBIA%GKS-PRIME%'
                                                 OR UPPER(vpa.long_description) LIKE 'PTC%IMPLANT%TIBIAL%'
                                                 OR UPPER(vpa.long_description) LIKE 'RALLONGE%TIBIALE%'
                                                 THEN 'COMPOSANT TIBIAL'

                                             -- CONDYLE PROTHESE FEMUR A CIMENTEE
                                             WHEN (
                                                      UPPER(vpa.long_description) LIKE '%CONDYLE FÉMORAL%'
                                                          OR (UPPER(vpa.long_description) LIKE '%FEMUR%'
                                                          AND UPPER(vpa.long_description) LIKE '%PS%')
                                                          OR (UPPER(vpa.long_description) LIKE '%HEMICALE%'
                                                          AND UPPER(vpa.long_description) LIKE '%FEMORALE%')
                                                          OR (UPPER(vpa.long_description) LIKE '%TRIATHLON%'
                                                          AND UPPER(vpa.long_description) LIKE '%FEMORALE%')
                                                      )
                                                 AND ( UPPER(vpa.long_description) LIKE '%CIMENT%'
                                                     OR UPPER(vpa.long_description) LIKE '%CEMENT%')
                                                 AND UPPER(vpa.long_description) NOT LIKE '%PS-U2%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%ANATOMIC%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%ESSAI%'
                                                 THEN 'CONDYLE PROTHESE FEMUR A CIMENTER'

                                             -- CONDYLE PROTHESE FEMUR NON CIMENTEE
                                             WHEN (
                                                      UPPER(vpa.long_description) LIKE '%CONDYLE FÉMORAL%'
                                                          OR (UPPER(vpa.long_description) LIKE '%FEMUR%'
                                                          AND UPPER(vpa.long_description) LIKE '%PS%')
                                                          OR (UPPER(vpa.long_description) LIKE '%HEMICALE%'
                                                          AND UPPER(vpa.long_description) LIKE '%FEMORALE%')
                                                          OR (UPPER(vpa.long_description) LIKE '%TRIATHLON%'
                                                          AND UPPER(vpa.long_description) LIKE '%FEMORALE%')
                                                      )
                                                 AND NOT (
                                                     UPPER(vpa.long_description) LIKE '%CIMENT%'
                                                         OR UPPER(vpa.long_description) LIKE '%CEMENT%'
                                                     )
                                                 THEN 'CONDYLE PROTHESE FEMUR'

                                             -- KIT IMPLANT ORTHOPEDIQUE
                                             WHEN (UPPER(vpa.long_description) LIKE 'KIT IMPLANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%VARIAX2%')
                                                 OR (UPPER(vpa.long_description) LIKE '%KIT%'
                                                     AND (UPPER(vpa.long_description) LIKE '%VARIAX%'
                                                         OR UPPER(vpa.long_description) LIKE '%VARIA%')
                                                      )
                                                 THEN 'KIT IMPLANT ORTHOPEDIQUE'

                                             -- IMPLANT DENTAIRE
                                             WHEN UPPER(vpa.long_description) LIKE 'IMPLANT%DENTAIRE%'
                                                 THEN 'IMPLANT DENTAIRE'

                                             -- KIT PROMONTOFIXATION
                                             WHEN UPPER(vpa.long_description) LIKE 'KIT%SACROMESH9%'
                                                 OR UPPER(vpa.long_description) LIKE 'IMPLT%SACROMESH9%'
                                                 OR UPPER(vpa.long_description) LIKE 'PROMONTO%SACROMESH%'
                                                 OR UPPER(vpa.long_description) LIKE 'PRO-SWING%'
                                                 THEN 'IMPLANT PROMONTOFIXATION'

                                             -- KIT CONNEXION UROLOGIE
                                             WHEN UPPER(vpa.long_description) LIKE 'KIT%CONNEXION%AMS%' THEN 'KIT CONNEXION UROLOGIE'

                                             -- KIT CHIRURGICAL
                                             WHEN UPPER(vpa.long_description) LIKE '%KIT%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%KIT%URETHRAL%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%CAPUCHON%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%RASP%'
                                                 AND UPPER(vpa.long_description) NOT LIKE 'ENDOPROTHESE%'
                                                 AND UPPER(vpa.long_description) NOT LIKE 'PLAQUE%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%GRAIN%'
                                                 THEN 'KIT CHIRURGIE'

                                             -- IMPLANT RENFORT
                                             WHEN (
                                                 (UPPER(vpa.long_description) LIKE 'IMPLANT%' AND UPPER(vpa.long_description) LIKE '%RENFORT%')
                                                     OR (UPPER(vpa.long_description) LIKE 'PLAQUE%' AND UPPER(vpa.long_description) LIKE '%BIOMESH%')
                                                     OR UPPER(vpa.long_description) LIKE 'PLAQUE%SWING%'
                                                     OR UPPER(vpa.long_description) LIKE 'SWING CONTACT%'
                                                     OR (
                                                     (UPPER(vpa.long_description) LIKE 'PROTHESE%' OR UPPER(vpa.long_description) LIKE 'IMPLT%')
                                                         AND UPPER(vpa.manufacturer_article_reference) LIKE 'SM3+ 6513L'
                                                     )
                                                 )
                                                 THEN 'IMPLANT DE RENFORT'

                                             WHEN UPPER(vpa.long_description) LIKE 'TREILLIS%'
                                                 OR UPPER(vpa.long_description) LIKE 'PLAQUE%TREILLIS%'
                                                 OR UPPER(vpa.long_description) LIKE 'IMPLANT%INTRAMESH%'
                                                 OR UPPER(vpa.long_description) LIKE 'IMPLANT%4DMESH%'
                                                 OR (UPPER(vpa.long_description) LIKE '4'
                                                     AND UPPER(vpa.manufacturer_article_reference) LIKE '%4DMESH%'
                                                      )
                                                 OR UPPER(vpa.long_description) LIKE 'MICRO%MAILLES%'
                                                 OR UPPER(vpa.long_description) LIKE 'NEOVEIL%'
                                                 THEN 'IMPLANT DE RENFORT'

                                             WHEN UPPER(vpa.long_description) LIKE 'IMPLT%'
                                                 AND (UPPER(vpa.long_description) LIKE '%PAROI%'
                                                     OR UPPER(vpa.long_description) LIKE '%HERNIE%')
                                                 THEN 'IMPLANT DE RENFORT'

                                             -- MAILLE HERNIAIRE
                                             WHEN (UPPER(vpa.long_description) LIKE '%PROLENE%'
                                                 AND UPPER(vpa.long_description) LIKE '%HERNIE%')
                                                 OR (UPPER(vpa.long_description) LIKE '%COMPOSITE%'
                                                     AND UPPER(vpa.long_description) LIKE '%VENTRAL%')
                                                 OR UPPER(vpa.long_description) LIKE '%PROMESH%'
                                                 OR UPPER(vpa.long_description) LIKE '%BIOMESH%'
                                                 OR UPPER(vpa.long_description) LIKE '%PARIETEX%'
                                                 OR UPPER(vpa.long_description) LIKE 'PAROI%PARIET%'
                                                 OR UPPER(vpa.long_description) LIKE 'PAROI%HERNIE%'
                                                 OR UPPER(vpa.long_description) LIKE 'RENFORT%PAROI%'
                                                 OR UPPER(vpa.long_description) LIKE 'RENFORT%EVENTRATION%'
                                                 OR UPPER(vpa.long_description) LIKE 'RENFORT%SYMBOTEX%'
                                                 OR UPPER(vpa.long_description) LIKE 'VERSATEX%MONO%'
                                                 THEN 'IMPLANT DE RENFORT'

                                             -- PLAQUE
                                             WHEN (UPPER(vpa.long_description) LIKE '%PLAQUE%'
                                                 OR UPPER(vpa.long_description) LIKE 'PLAQUE%'
                                                 OR UPPER(vpa.long_description) LIKE 'TRILOCK%'
                                                 OR UPPER(vpa.long_description) LIKE 'ANKLE%'
                                                 OR UPPER(vpa.long_description) LIKE '%PLAQUE CERVICALE%'
                                                 OR UPPER(vpa.long_description) LIKE 'VARIAX MAIN%TITANE%'
                                                      )
                                                 AND UPPER(vpa.long_description) NOT LIKE '%BIOMESH%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%VISCERAL%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%TREILLIS%'
                                                 AND UPPER(vpa.long_description) NOT LIKE '%VIS%'
                                                 THEN 'PLAQUE'

                                             -- PROTHESE DE REFECTION
                                             WHEN UPPER(vpa.long_description) LIKE '%PROTHESE%'
                                                 AND (
                                                      UPPER(vpa.long_description) LIKE '%REFECTION%'
                                                          OR (UPPER(vpa.long_description) LIKE '%SWING%'
                                                          AND UPPER(vpa.long_description) NOT LIKE '%CONTACT%')
                                                      )
                                                 THEN 'PROTHESE DE REFECTION'

                                             -- IMPLANT FILETE METACARPIEN
                                             WHEN (
                                                 (UPPER(vpa.long_description) LIKE 'IMPLANT%'
                                                     AND UPPER(vpa.long_description) LIKE '%FILETE%'
                                                     AND UPPER(vpa.long_description) LIKE '%METACARPIEN%')

                                                     OR (UPPER(vpa.long_description) LIKE 'VIS%'
                                                     AND UPPER(vpa.long_description) LIKE '%METACARPIENNE%'
                                                     AND UPPER(vpa.long_description) LIKE '%WRIST%')

                                                 )
                                                 THEN 'IMPLANT FILETE METACARPIEN'

                                             -- IMPLANT FILETE
                                             WHEN UPPER(vpa.long_description) LIKE 'IMPLANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%FILETE%'
                                                 AND UPPER(vpa.long_description) LIKE '%RADIAL%'
                                                 THEN 'IMPLANT FILETE RADIAL'

                                             -- IMPLANT TALIEN
                                             WHEN UPPER(vpa.long_description) LIKE 'IMPLANT DOME%'
                                                 OR UPPER(vpa.long_description) LIKE 'PTC%DOME%'
                                                 THEN 'IMPLANT TALIEN'

                                             -- IMPLANT MAMMAIRE
                                             WHEN (UPPER(vpa.long_description) LIKE 'IMPLANT%'
                                                 OR UPPER(vpa.long_description) LIKE 'PERLE%')
                                                 AND UPPER(vpa.long_description) LIKE '%MAMMAIRE%'
                                                 THEN 'IMPLANT MAMMAIRE'

                                             -- IMPLANT BIOINDUCTIF
                                             WHEN UPPER(vpa.long_description) LIKE '%BIOINDUCIVE%'
                                                 OR UPPER(vpa.long_description) LIKE 'MATRICE%COLLAGENE%'
                                                 OR UPPER(vpa.long_description) LIKE '%REGENETEN%'
                                                 THEN 'IMPLANT BIOINDUCTIF'

                                             -- IMPLANT MODULAIRE
                                             WHEN UPPER(vpa.long_description) LIKE '%MUTARS%'
                                                 OR UPPER(vpa.long_description) LIKE '%PIECE DE COUPLAGE%'
                                                 OR UPPER(vpa.long_description) LIKE '%DOUBLE CONE%'
                                                 OR UPPER(vpa.long_description) LIKE 'ACS%CONE%DOUBLE%'
                                                 THEN 'PROTHESE MODULAIRE'

                                             -- IMPLANT SCAPHOIDIEN
                                             WHEN UPPER(vpa.long_description) LIKE '%SCAPHOIDIEN%'
                                                 OR UPPER(vpa.long_description) LIKE '%RCPI%'
                                                 OR UPPER(vpa.long_description) LIKE '%SCAPHOIDE%'
                                                 THEN 'IMPLANT SCAPHOIDIEN'

                                             -- IMPLANT TIBIAL
                                             WHEN UPPER(vpa.long_description) LIKE 'IMPLANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%TIBIAL%'
                                                 THEN 'IMPLANT TIBIAL'

                                             -- PROTHESE FEMORO-PATELLAIRE
                                             WHEN UPPER(vpa.long_description) LIKE '%PATELLO FEMORAL%'
                                                 OR UPPER(vpa.long_description) LIKE '%FEMORO PATELLAIRE%'
                                                 THEN 'PROTHESE FEMORO-PATELLAIRE'

                                             -- IMPLANT ROTULE
                                             WHEN UPPER(vpa.long_description) LIKE 'IMPLANT ROTULIEN%'
                                                 OR UPPER(vpa.long_description) LIKE '%PATELLA%'
                                                 OR (
                                                      UPPER(vpa.long_description) LIKE 'ATTUNE MEDIALIZED%'
                                                          AND UPPER(vpa.long_description) LIKE '%PAT%')
                                                 OR (
                                                      UPPER(vpa.long_description) LIKE 'NEXGEN%'
                                                          AND UPPER(vpa.long_description) LIKE '%ROTULE%')
                                                 OR UPPER(vpa.long_description) LIKE '%IMPLANT%RESURFACAGE%'
                                                 OR UPPER(vpa.long_description) LIKE '%IMPLANT%PYROCARDAN%'
                                                 THEN 'IMPLANT ROTULE'

                                             -- IMPLANT  ROTULE
                                             WHEN UPPER(vpa.long_description) LIKE '%TRIATHLON'
                                                 OR UPPER(vpa.long_description) LIKE '%ROTULE%'
                                                 OR UPPER(vpa.long_description) LIKE 'DOME%ROTULIEN%'
                                                 OR UPPER(vpa.long_description) LIKE 'BOUTON%ROTULIEN%'
                                                 THEN 'IMPLANT ROTULE'

                                             -- IMPLANT INTRAMEDULLAIRE
                                             WHEN UPPER(vpa.long_description) LIKE '%IMPLANT%'
                                                 AND UPPER(vpa.long_description) LIKE '%INTRAMEDULLAIRE%'
                                                 THEN 'IMPLANT INTRAMEDULLAIRE'

                                             -- IMPLANT FUSION SPINALE / ARTHRODESE
                                             WHEN UPPER(vpa.long_description) LIKE '%X-FUSE%'
                                                 OR UPPER(vpa.long_description) LIKE '%PROTHESE%ARTICULAIRE%KERIFUSE%'
                                                 THEN 'IMPLANT ARTHRODESE'

                                             WHEN UPPER(vpa.long_description) LIKE '%INDIVIDUAL HIP TIHA%'
                                                 OR UPPER(vpa.long_description) LIKE '%MTP%'
                                                 OR UPPER(vpa.long_description) LIKE '%FEMUR RHK%'
                                                 OR UPPER(vpa.long_description) LIKE 'COUPLEUR%LEGION%'
                                                 THEN 'IMPLANT ORTHOPEDIQUE'

